From: Robin Snyders <robin@snyders.xyz>
Subject: [PATCH] Open the sensors before exporting the D-Bus interface

bus_acquired_handler registers both D-Bus objects, making every property
readable and every method callable, while discovery and driver_open only
run afterwards in name_acquired_handler. A client watching the bus name
therefore sees HasAccelerometer as FALSE, or claims a sensor, before any
device exists.

The window is small but reliably lost on slow sensor stacks. On a
Qualcomm SM8150 phone, where each SSC sensor costs a QMI round trip over
QRTR, Phosh checked the properties while they were still FALSE and never
looked again, so the screen stopped rotating after every daemon restart.

Move discovery and opening into bus_acquired_handler, ahead of
g_dbus_connection_register_object, so nothing is visible until the
devices behind it exist. The initial property notifications stay in
name_acquired_handler, which now only announces them.

Adapted for 3.9 from hotdog-linux-bringup (OnePlus 7T Pro) patch 0010.
---
--- a/src/iio-sensor-proxy.c	2026-03-02 12:19:51.000000000 -0700
+++ b/src/iio-sensor-proxy.c	2026-10-14 12:55:47.675551405 -0600
@@ -706,6 +706,48 @@
 	exit (0);
 }
 
+static gboolean
+setup_sensors (SensorData *data)
+{
+	guint i;
+
+	if (!find_sensors (data->client, data))
+		goto bail;
+
+	g_signal_connect (G_OBJECT (data->client), "uevent",
+			  G_CALLBACK (sensor_changes), data);
+
+	for (i = 0; i < NUM_SENSOR_TYPES; i++) {
+		SensorDevice *sensor_device;
+
+		data->sensor_startup_dbus_invocations_delayed[i] = g_ptr_array_new ();
+
+		if (!driver_type_exists (data, i))
+			continue;
+
+		sensor_device = driver_open (DRIVER_FOR_TYPE(i), UDEV_DEVICE_FOR_TYPE(i),
+					     driver_type_to_callback_func (data->drivers[i]->type), data);
+		if (!sensor_device) {
+			DRIVER_FOR_TYPE(i) = NULL;
+			g_clear_object (&UDEV_DEVICE_FOR_TYPE(i));
+			continue;
+		}
+
+		DEVICE_FOR_TYPE(i) = sensor_device;
+	}
+
+	if (!any_sensors_left (data))
+		goto bail;
+
+	return TRUE;
+
+bail:
+	data->ret = 0;
+	g_message ("No sensors or missing kernel drivers for the sensors. Exiting");
+	g_main_loop_quit (data->loop);
+	return FALSE;
+}
+
 static void
 bus_acquired_handler (GDBusConnection *connection,
 		      const gchar     *name,
@@ -721,7 +763,23 @@
 #endif
 		NULL
     };
-	guint i;
+
+	/* Initialize DBus clients hash table before DBus is fully exposed */
+	data->client = g_udev_client_new (subsystems);
+
+	for (guint i = 0; i < NUM_SENSOR_TYPES; i++)
+		data->clients[i] = create_clients_hash_table ();
+
+	data->connection = g_object_ref (connection);
+
+	/* Discover and open every sensor before the interface is exported.
+	 * Otherwise a client watching the bus name reads HasAccelerometer
+	 * and friends as FALSE, or claims a sensor, before discovery has run.
+	 * On the SSC path each sensor costs a QMI round trip, so that window
+	 * is long enough for a compositor to decide there is no sensor and
+	 * never look again. */
+	if (!setup_sensors (data))
+		return;
 
 	g_dbus_connection_register_object (connection,
 					   SENSOR_PROXY_DBUS_PATH,
@@ -738,14 +796,6 @@
 					   data,
 					   NULL,
 					   NULL);
