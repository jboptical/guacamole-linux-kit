			i2c@890000 {
				compatible = "qcom,geni-i2c";
				reg = <0x00 0x890000 0x00 0x4000>;
				clock-names = "se";
				clocks = <0x2c 0x59>;
				dmas = <0x2d 0x00 0x04 0x03 0x2d 0x01 0x04 0x03>;
				dma-names = "tx", "rx";
				pinctrl-names = "default";
				pinctrl-0 = <0x36>;
				interrupts = <0x00 0x25d 0x04>;
