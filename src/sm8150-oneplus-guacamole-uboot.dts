					regulator-name = "vreg_ldo4_c";
					regulator-min-microvolt = <0x1a0040>;
					regulator-max-microvolt = <0x2cad80>;
					regulator-initial-mode = <0x03>;
				};

				ldo5 {
					regulator-name = "vreg_ldo5_c";
					regulator-min-microvolt = <0x1a0040>;
					regulator-max-microvolt = <0x2cad80>;
					regulator-initial-mode = <0x03>;
				};

				ldo6 {
					regulator-name = "vreg_ldo6_c";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x2d2a80>;
					regulator-initial-mode = <0x03>;
				};

				ldo7 {
					regulator-name = "vreg_ldo7_c";
					regulator-min-microvolt = <0x2b9440>;
					regulator-max-microvolt = "", "/]";
					regulator-initial-mode = <0x03>;
				};

				ldo8 {
					regulator-name = "vreg_ldo8_c";
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					regulator-initial-mode = <0x03>;
				};

				ldo9 {
					regulator-name = "vreg_ldo9_c";
					regulator-min-microvolt = <0x294280>;
					regulator-max-microvolt = <0x2d2a80>;
					regulator-initial-mode = <0x03>;
				};

				ldo10 {
					regulator-name = "vreg_ldo10_c";
					regulator-min-microvolt = <0x2dc6c0>;
					regulator-max-microvolt = <0x328980>;
					regulator-initial-mode = <0x03>;
					phandle = <0x50>;
				};

				vreg_l11c_3p3: ldo11 {
					regulator-name = "vreg_l11c_3p3";
					regulator-min-microvolt = <0x2dc6c0>;
					regulator-max-microvolt = <0x328980>;
					regulator-initial-mode = <0x03>;
				};
			};

			pm8009-rpmh-regulators {
				compatible = "qcom,pm8009-rpmh-regulators";
				qcom,pmic-id = "f";
				vdd-s1-supply = <0xe0>;
				vdd-s2-supply = <0xe2>;
				vdd-l2-supply = <0xe3>;
				vdd-l5-l6-supply = <0xe2>;

				ldo2 {
					regulator-name = "vreg_ldo2_f";
					regulator-min-microvolt = <0x124f80>;
					regulator-max-microvolt = <0x124f80>;
					regulator-initial-mode = <0x03>;
				};

				ldo5 {
					regulator-name = "vreg_ldo5_f";
					regulator-min-microvolt = <0x2ab980>;
					regulator-max-microvolt = <0x2ab980>;
					regulator-initial-mode = <0x03>;
				};

				ldo6 {
					regulator-name = "vreg_ldo6_f";
					regulator-initial-mode = <0x03>;
					regulator-min-microvolt = <0x2b9440>;
					regulator-max-microvolt = <0x2b9440>;
				};
			};
		};

		interconnect@18321000 {
			compatible = "qcom,sm8150-osm-l3", "qcom,osm-l3";
			reg = <0x00 0x18321000 0x00 0x1400>;
			clocks = <0x29 0x00 0x2c 0xc5>;
			clock-names = "xo", "alternate";
			#interconnect-cells = <0x01>;
			phandle = <0x07>;
		};

		cpufreq@18323000 {
			compatible = "qcom,sm8150-cpufreq-hw", "qcom,cpufreq-hw";
			reg = <0x00 0x18323000 0x00 0x1400 0x00 0x18325800 0x00 0x1400 0x00 0x18327800 0x00 0x1400>;
			reg-names = "freq-domain0", "freq-domain1", "freq-domain2";
			clocks = <0x29 0x00 0x2c 0xc5>;
			clock-names = "xo", "alternate";
			#freq-domain-cells = <0x01>;
			#clock-cells = <0x01>;
			phandle = <0x02>;
		};

		lmh@18350800 {
			compatible = "qcom,sm8150-lmh";
			reg = <0x00 0x18350800 0x00 0x400>;
			interrupts = <0x00 0x21 0x04>;
			cpus = <0x1e>;
			qcom,lmh-temp-arm-millicelsius = <0xea60>;
			qcom,lmh-temp-low-millicelsius = <0x14a14>;
			qcom,lmh-temp-high-millicelsius = <0x14c08>;
			interrupt-controller;
			#interrupt-cells = <0x01>;
		};

		lmh@18358800 {
			compatible = "qcom,sm8150-lmh";
			reg = <0x00 0x18358800 0x00 0x400>;
			interrupts = <0x00 0x20 0x04>;
			cpus = <0x1a>;
			qcom,lmh-temp-arm-millicelsius = <0xea60>;
			qcom,lmh-temp-low-millicelsius = <0x14a14>;
			qcom,lmh-temp-high-millicelsius = <0x14c08>;
			interrupt-controller;
			#interrupt-cells = <0x01>;
		};

		wifi@18800000 {
			compatible = "qcom,wcn3990-wifi";
			reg = <0x00 0x18800000 0x00 0x800000>;
			reg-names = "membase";
			memory-region = <0xe5>;
			clock-names = "cxo_ref_clk_pin", "qdss";
			clocks = <0x29 0x08 0x71>;
			interrupts = <0x00 0x19e 0x04 0x00 0x19f 0x04 0x00 0x1a0 0x04 0x00 0x1a1 0x04 0x00 0x1a2 0x04 0x00 0x1a3 0x04 0x00 0x1a4 0x04 0x00 0x1a5 0x04 0x00 0x1a6 0x04 0x00 0x1a7 0x04 0x00 0x1a8 0x04 0x00 0x1a9 0x04>;
			iommus = <0x2b 0x640 0x01>;
			/* WCN3990 rails, as in the stock qcom,icnss node (no separate ch1 rail on this phone) */
			vdd-0.8-cx-mx-supply = <&vreg_l1a_0p75>;
			vdd-1.8-xo-supply = <&vreg_l7a_1p8>;
			vdd-1.3-rfa-supply = <&vreg_l2c_1p3>;
			vdd-3.3-ch0-supply = <&vreg_l11c_3p3>;
			status = "okay";
		};
	};

	/*
	 * Battery limits for the PM8150B SMB5 charger. Conservative initial
	 * values, below the stock limits: stock fv-max 4.365 V, OP_4000mAh
	 * profile 4.37 V max and 3.0 A fast charge, op,sw-iterm 310 mA.
	 */
	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion-polymer";
		charge-full-design-microamp-hours = <4000000>;
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4370000>;
		constant-charge-current-max-microamp = <3000000>;
		constant-charge-voltage-max-microvolt = <4350000>;
		charge-term-current-microamp = <310000>;
	};

	/* Volume keys on PM8150 GPIO 6/7 (active low), as in the stock gpio_keys node */
	gpio-keys {
		compatible = "gpio-keys";
		label = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&vol_up_default &vol_down_default>;

		key-vol-up {
			label = "Volume Up";
			gpios = <0xd4 6 0x11>;
			linux,input-type = <1>;
			linux,code = <115>;
			wakeup-source;
			debounce-interval = <15>;
		};

		key-vol-down {
			label = "Volume Down";
			gpios = <0xd4 7 0x11>;
			linux,input-type = <1>;
			linux,code = <114>;
			wakeup-source;
			debounce-interval = <15>;
		};
	};

	sound: sound {
		compatible = "qcom,sm8150-sndcard";
		model = "OnePlus 7 Pro";
		pinctrl-names = "default";
		pinctrl-0 = <&quat_mi2s_active &quat_mi2s_sd0_active &quat_mi2s_sd1_active>;
		/* Mic bias wiring from the stock OxygenOS sm8150-tavil-snd-card routing */
		audio-routing = "RX_BIAS", "MCLK",
				"AMIC1", "MIC BIAS1",
				"AMIC2", "MIC BIAS2",
				"AMIC3", "MIC BIAS4",
				"AMIC4", "MIC BIAS1",
				"AMIC5", "MIC BIAS1";

		mm1-dai-link {
			link-name = "MultiMedia1";
			cpu {
				sound-dai = <&q6asmdai 0>;
			};
		};

		mm2-dai-link {
			link-name = "MultiMedia2";
			cpu {
				sound-dai = <&q6asmdai 1>;
			};
		};

		mm3-dai-link {
			link-name = "MultiMedia3";
			cpu {
				sound-dai = <&q6asmdai 2>;
			};
		};

		mm4-dai-link {
			link-name = "MultiMedia4";
			cpu {
				sound-dai = <&q6asmdai 3>;
			};
		};

		mm5-dai-link {
			link-name = "MultiMedia5";
			cpu {
				sound-dai = <&q6asmdai 4>;
			};
		};

		mm6-dai-link {
			link-name = "MultiMedia6";
			cpu {
				sound-dai = <&q6asmdai 5>;
			};
		};

		speaker-dai-link {
			link-name = "Speaker Playback";
			cpu {
				sound-dai = <&q6afedai 22>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&speaker_top>, <&speaker_bottom>;
			};
		};

		slim-dai-link {
			link-name = "SLIM Playback 1";
			cpu {
				sound-dai = <&q6afedai 2>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd9340 0>;
			};
		};

		slimcap-dai-link {
			link-name = "SLIM Capture 1";
			cpu {
				sound-dai = <&q6afedai 3>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd9340 1>;
			};
		};

		slim2-dai-link {
			link-name = "SLIM Playback 2";
			cpu {
				sound-dai = <&q6afedai 4>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd9340 2>;
			};
		};

		slimcap2-dai-link {
			link-name = "SLIM Capture 2";
			cpu {
				sound-dai = <&q6afedai 5>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd9340 3>;
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x01 0x08 0x01 0x02 0x08 0x01 0x03 0x08 0x01 0x00 0x08>;
	};

	thermal-zones {

		cpu0-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xe6 0x01>;

			trips {

				trip-point0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0xe7>;
				};

				trip-point1 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0xe8>;
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0xe7>;
					cooling-device = <0x1a 0xffffffff 0xffffffff 0x1b 0xffffffff 0xffffffff 0x1c 0xffffffff 0xffffffff 0x1d 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0xe8>;
					cooling-device = <0x1a 0xffffffff 0xffffffff 0x1b 0xffffffff 0xffffffff 0x1c 0xffffffff 0xffffffff 0x1d 0xffffffff 0xffffffff>;
				};
