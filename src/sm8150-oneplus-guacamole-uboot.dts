			clocks = <0x2c 0x18 0x2c 0x1d 0x2c 0x19 0x2c 0x1b>;
			interrupts = <0x00 0x2b1 0x04 0x00 0x2bb 0x04>;
			interrupt-names = "macirq", "eth_lpi";
			power-domains = <0x2c 0x06>;
			resets = <0x2c 0x00>;
			iommus = <0x2b 0x3c0 0x00>;
			snps,tso;
			rx-fifo-depth = <0x1000>;
			tx-fifo-depth = <0x1000>;
			status = "disabled";
		};

		efuse@784000 {
			compatible = "qcom,sm8150-qfprom", "qcom,qfprom";
