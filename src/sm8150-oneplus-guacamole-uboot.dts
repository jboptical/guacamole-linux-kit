					};

					opp6 {
						opp-level = <0xe0>;
					};

					opp7 {
						opp-level = <0x100>;
						phandle = <0xc4>;
					};

					opp8 {
						opp-level = <0x140>;
					};

					opp9 {
						opp-level = <0x150>;
					};

					opp10 {
						opp-level = <0x180>;
					};

					opp11 {
						opp-level = <0x1a0>;
					};
				};
			};

			bcm-voter {
				compatible = "qcom,bcm-voter";
				phandle = <0x5f>;
			};

			pm8150-rpmh-regulators {
				compatible = "qcom,pm8150-rpmh-regulators";
				qcom,pmic-id = "a";
				vdd-s1-supply = <0xe0>;
				vdd-s2-supply = <0xe0>;
				vdd-s3-supply = <0xe0>;
				vdd-s4-supply = <0xe0>;
				vdd-s5-supply = <0xe0>;
				vdd-s6-supply = <0xe0>;
				vdd-s7-supply = <0xe0>;
				vdd-s8-supply = <0xe0>;
				vdd-s9-supply = <0xe0>;
				vdd-s10-supply = <0xe0>;
				vdd-l1-l8-l11-supply = <0xe1>;
				vdd-l2-l10-supply = <0xe2>;
				vdd-l3-l4-l5-l18-supply = <0xe1>;
				vdd-l6-l9-supply = <0xe3>;
				vdd-l7-l12-l14-l15-supply = <0xe4>;
				vdd-l13-l16-l17-supply = <0xe2>;

				smps5 {
					regulator-name = "vreg_smps5_a";
					regulator-min-microvolt = <0x1d0d80>;
					regulator-max-microvolt = <0x1f20c0>;
					phandle = <0xe4>;
				};

				smps6 {
					regulator-name = "vreg_smps6_a";
					regulator-min-microvolt = <0xe09c0>;
