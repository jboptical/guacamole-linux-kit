				dmas = <0x2d 0x00 0x00 0x01 0x2d 0x01 0x00 0x01>;
				dma-names = "tx", "rx";
				pinctrl-names = "default";
				pinctrl-0 = <0x2f>;
				interrupts = <0x00 0x259 0x04>;
				spi-max-frequency = <0x2faf080>;
