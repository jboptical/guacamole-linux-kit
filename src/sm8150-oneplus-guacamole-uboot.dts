	firmware {

		scm {
			compatible = "qcom,scm-sm8150", "qcom,scm";
			#reset-cells = <0x01>;
			qcom,dload-mode = <0x534 0x13000>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x00>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x05 0x04>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x22>;
			domain-idle-states = <0x23>;
			phandle = <0x08>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x22>;
			domain-idle-states = <0x23>;
			phandle = <0x0b>;
		};

		power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x22>;
			domain-idle-states = <0x23>;
			phandle = <0x0d>;
		};

		power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x22>;
			domain-idle-states = <0x23>;
			phandle = <0x0f>;
		};

		power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x22>;
			domain-idle-states = <0x24>;
			phandle = <0x12>;
		};

		power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x22>;
			domain-idle-states = <0x24>;
			phandle = <0x14>;
		};

		power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x22>;
			domain-idle-states = <0x24>;
			phandle = <0x16>;
		};

		power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x22>;
			domain-idle-states = <0x24>;
			phandle = <0x19>;
		};

		power-domain-cpu-cluster0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x25>;
			phandle = <0x22>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		/*
		 * Bootloader splash framebuffer / display ramdump (stock
		 * cont_splash_region + disp_rdump_region). Without this, Linux hands
		 * the pages out and buffered writes intermittently come back as
		 * zeros (UFS "OCS invalid" completions), as on the OnePlus 7T Pro
		 * before its reserved-memory map matched stock.
		 */
		memory@9c000000 {
			compatible = "qcom,cont-splash-region";
			reg = <0x00 0x9c000000 0x00 0x2400000>;
			no-map;
		};

		memory@85700000 {
			reg = <0x00 0x85700000 0x00 0x600000>;
			no-map;
		};

		memory@85e00000 {
			reg = <0x00 0x85e00000 0x00 0x100000>;
			no-map;
		};

		memory@85f00000 {
			reg = <0x00 0x85f00000 0x00 0x20000>;
			no-map;
		};

		memory@85f20000 {
			compatible = "qcom,cmd-db";
			reg = <0x00 0x85f20000 0x00 0x20000>;
			no-map;
		};

		memory@86000000 {
			reg = <0x00 0x86000000 0x00 0x200000>;
			no-map;
			phandle = <0x26>;
		};

		memory@86200000 {
			reg = <0x00 0x86200000 0x00 0x5500000>;
			no-map;
		};

		memory@8b700000 {
			reg = <0x00 0x8b700000 0x00 0x500000>;
			no-map;
		};

		memory@8bc00000 {
			reg = <0x00 0x8bc00000 0x00 0x180000>;
			no-map;
			phandle = <0xe5>;
		};

		memory@8bd80000 {
			reg = <0x00 0x8bd80000 0x00 0x80000>;
			no-map;
		};

		memory@8be00000 {
			reg = <0x00 0x8be00000 0x00 0x1e00000>;
			no-map;
			phandle = <0xdc>;
		};

		memory@8d800000 {
			reg = <0x00 0x8dc00000 0x00 0x9600000>;
			no-map;
			phandle = <0x7c>;
		};

		memory@96e00000 {
			reg = <0x00 0x97200000 0x00 0x500000>;
			no-map;
		};

		memory@97300000 {
			reg = <0x00 0x97700000 0x00 0x1400000>;
			no-map;
			phandle = <0x70>;
		};

		memory@98700000 {
			reg = <0x00 0x98b00000 0x00 0x10000>;
			no-map;
			phandle = <0x538>;
		};

		memory@98710000 {
			reg = <0x00 0x98b10000 0x00 0x5000>;
			no-map;
		};

		memory@98715000 {
			reg = <0x00 0x98b15000 0x00 0x2000>;
			no-map;
			phandle = <0x77>;
		};

		memory@98800000 {
			reg = <0x00 0x98c00000 0x00 0x100000>;
			no-map;
		};

		memory@98900000 {
			reg = <0x00 0x98d00000 0x00 0x1400000>;
			no-map;
			phandle = <0xab>;
		};

		memory@9e400000 {
			reg = <0x00 0x9e400000 0x00 0x1400000>;
			no-map;
		};

		fastrpc-shared-pool {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			size = <0x00 0x1000000>;
			reusable;
			phandle = <0x539>;
		};

		memory@f2901000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x00 0xf2901000 0x00 0x200000>;
			no-map;
			qcom,client-id = <0x01>;
			qcom,vmid = <0x0f>;
		};
		bootloader_log_mem@9fff7000 { reg = <0x00 0x9fff7000 0x00 0x9000>; no-map; };
		cdsp_sec_regions@a4c00000 { compatible = "removed-dma-pool"; no-map; reg = <0x00 0xa4c00000 0x00 0x3c00000>; };
		ramoops@a9800000 { compatible = "ramoops"; reg = <0x00 0xa9800000 0x00 0x400000>; record-size = <0x40000>; console-size = <0x40000>; ftrace-size = <0x40000>; pmsg-size = <0x200000>; };
		param_mem@ac200000 { reg = <0x00 0xac200000 0x00 0x100000>; no-map; };
		mtp_mem@ac300000 { reg = <0x00 0xac300000 0x00 0xb00000>; no-map; };
	};

	smem {
		compatible = "qcom,smem";
		memory-region = <0x26>;
		hwlocks = <0x27 0x03>;
	};

	smp2p-cdsp {
		compatible = "qcom,smp2p";
		qcom,smem = <0x5e 0x1b0>;
		interrupts = <0x00 0x240 0x01>;
		mboxes = <0x28 0x06>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x05>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0xac>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0xaa>;
		};
	};

	smp2p-lpass {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1bb 0x1ad>;
		interrupts = <0x00 0x9e 0x01>;
		mboxes = <0x28 0x0a>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x02>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0xdd>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0xdb>;
		};
	};

	smp2p-mpss {
		compatible = "qcom,smp2p";
