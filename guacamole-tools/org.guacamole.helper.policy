<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>guacamole-linux-kit</vendor>
  <action id="org.guacamole.helper">
    <description>Change OnePlus 7 Pro charging, CPU, suspend, swap and brightness settings</description>
    <message>Guacamole wants to change charging, CPU, suspend, swap or brightness settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/guacamole-helper</annotate>
  </action>
</policyconfig>
